title: $:/plugins/wikilabs/scroll-memory/back-button
tags: $:/tags/PageTemplate

\whitespace trim
<$let
	smLandmark={{{ [{$:/temp/volatile/scroll-memory/back-stack}jsonindexes[]count[]compare:number:gt[0]then[yes]] ~[[no]] }}}
	smDraft={{{ [list[$:/StoryList]has[draft.of]limit[1]then[yes]] ~[[no]] }}}
	smToggle={{{ [[$:/config/wikilabs/scroll-memory/use-toggle]get[text]else[no]] }}}
	smAlways={{{ [[$:/config/wikilabs/scroll-memory/always-active]get[text]else[no]] }}}
	smTopCfg={{{ [[$:/config/wikilabs/scroll-memory/top-button]get[text]else[yes]] }}}
	smTopTgt={{{ [{$:/temp/volatile/scroll-memory/top-target}!is[blank]then[yes]] ~[[no]] }}}
	smTopShow={{{ [<smTopCfg>!match[no]then<smTopTgt>match[yes]then[yes]] ~[[no]] }}}
	smArrows={{{ [<smAlways>match[yes]then<smLandmark>match[yes]then[yes]] ~[[no]] }}}
	smShowToggle={{{ [<smDraft>match[yes]then[yes]] [<smAlways>match[no]then<smToggle>match[yes]then<smLandmark>match[yes]then[yes]] +[first[]] ~[[no]] }}}
	smShowBack={{{ [<smAlways>match[no]then<smToggle>match[no]then<smDraft>match[no]then<smLandmark>match[yes]then[yes]] ~[[no]] }}}
>
<%if [<smArrows>match[yes]] [<smShowToggle>match[yes]] [<smShowBack>match[yes]] [<smTopShow>match[yes]] %>
<div
	class="wltc-scroll-memory-back"
	role="navigation"
	aria-label={{$:/language/wikilabs/scroll-memory/NavigationLabel}}
>
<%if [<smTopShow>match[yes]] %>
<$button
	message="tm-scroll-memory-top"
	class="tc-btn-invisible"
	tooltip={{$:/language/wikilabs/scroll-memory/Buttons/Top/Hint}}
	aria-label={{$:/language/wikilabs/scroll-memory/Buttons/Top/Hint}}
>
<span aria-hidden="true">{{$:/core/images/fold-button}}</span>
</$button>
<%endif%>
<%if [<smArrows>match[yes]] %>
<$button
	message="tm-scroll-memory-back"
	class="tc-btn-invisible"
	tooltip={{$:/language/wikilabs/scroll-memory/Buttons/Back/Hint}}
	aria-label={{$:/language/wikilabs/scroll-memory/Buttons/Back/Hint}}
>
<span aria-hidden="true">{{$:/core/images/left-arrow}}</span>
</$button>
<%endif%>
<!-- The toggle sits between the arrows, so always-active mode reads < o > -->
<%if [<smShowToggle>match[yes]] %>
<$button
	message="tm-scroll-memory-toggle"
	class="tc-btn-invisible"
	tooltip={{$:/language/wikilabs/scroll-memory/Buttons/Toggle/Hint}}
	aria-label={{$:/language/wikilabs/scroll-memory/Buttons/Toggle/Hint}}
>
<span aria-hidden="true">{{$:/core/images/close-others-button}}</span>
</$button>
<%endif%>
<%if [<smArrows>match[yes]] %>
<$button
	message="tm-scroll-memory-forward"
	class="tc-btn-invisible"
	tooltip={{$:/language/wikilabs/scroll-memory/Buttons/Forward/Hint}}
	aria-label={{$:/language/wikilabs/scroll-memory/Buttons/Forward/Hint}}
>
<span aria-hidden="true">{{$:/core/images/right-arrow}}</span>
</$button>
<%endif%>
<%if [<smShowBack>match[yes]] %>
<$button
	message="tm-scroll-memory-back"
	class="tc-btn-invisible"
	tooltip={{$:/language/wikilabs/scroll-memory/Buttons/BackConsume/Hint}}
	aria-label={{$:/language/wikilabs/scroll-memory/Buttons/BackConsume/Hint}}
>
<span aria-hidden="true">{{$:/core/images/fold-others-button}}</span>
</$button>
<%endif%>
</div>
<%endif%>
</$let>
