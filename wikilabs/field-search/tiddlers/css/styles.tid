title: $:/plugins/wikilabs/field-search/styles
tags: $:/tags/Stylesheet

.wltc-show-system {
  float: right;
  cursor: pointer;
}

.wltc-show-system input {
  visibility: hidden;
  margin-left: -1em;
  width: initial;
}

.wltc-show-system  input[checked] + span{
  color: blue;
  font-weight: bold;
}

/* Keyboard-selected search result looks like a hovered one, in every search tab */
.tc-block-dropdown .tc-list-item-selected a.tc-tiddlylink {
	color: <<colour tiddler-link-background>>;
	background-color: <<colour tiddler-link-foreground>>;
}
